{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint . --max-warnings=0",
    "stylelint": "stylelint \"{app,components,styles}/**/*.css\"",
    "prettier:check": "prettier --check \"{app,components,src,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs,cjs}\"",
    "prettier:write": "prettier --write \"{app,components,src,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs,cjs}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@next/bundle-analyzer": "16.3.8",
    "@tabler/icons-react": "3.48.0",
    "@vercel/analytics": "2.0.1",
    "framer-motion": "13.5.0",
    "i18next": "26.4.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "resolutions": {
    "@humanfs/node": "^0.16.8"
  }
}
